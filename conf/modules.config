/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MCSTAGING_MACSIMA2MC' {
        ext.args = {[
            params.illumination_correction  ? "-ic" : "",
            params.hi_exposure_only         ? "-he" : "",
            params.remove_reference_marker  ? "-rr" : "",
            params.qc_metrics               ? "-qc" : "",
            params.write_table              ? "-wt" : ""
        ].join(' ').trim()}
        publishDir = [
            path: { "${params.outdir}/macsima2mc/${meta.experiment}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ASHLAR' {
        ext.args  = '--flip-y'
        publishDir = [
            path: { "${params.outdir}/ashlar/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BACKSUB' {
        ext.prefix = { "${meta.id}_backsub" }
        publishDir = [
            path: { "${params.outdir}/backsub/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // MACSima segmentation (subworkflows/local/macsima_segmentation)
    // Model selection: a custom model file (--cellpose*_custom_model) is staged and passed to the module as input.
    // Otherwise the pretrained model name (--cellpose*_pretrained_model) is passed here via --pretrained_model.
    // 'none' (or 'null') skips --pretrained_model, so the tool falls back to its built-in default model.
    withName: 'CELLPOSE3' {
        ext.args = {[
            "--channel_axis 0",
            "--no_npy",
            params.cellpose3_save_flows                 ? "--save_flows"                                                : "",
            params.cellpose3_diameter != null           ? "--diameter ${params.cellpose3_diameter}"                     : "",
            params.cellpose3_chan                       ? "--chan ${params.cellpose3_chan}"                             : "",
            params.cellpose3_chan2                      ? "--chan2 ${params.cellpose3_chan2}"                           : "",
            params.cellpose3_custom_model               ? ""                                                            : params.cellpose3_pretrained_model && !(params.cellpose3_pretrained_model.toString().toLowerCase() in ['none', 'null']) ? "--pretrained_model ${params.cellpose3_pretrained_model}" : "",
            params.cellpose3_flow_threshold != null     ? "--flow_threshold ${params.cellpose3_flow_threshold}"         : "",
        ].join(' ').trim()}
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/segmentation/cellpose3/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Cellpose 4 (Cellpose-SAM), nf-core module. --chan/--chan2 are deprecated in cellpose >= 4.0.1
    // Cellpose 4's 2D CLI reader converts CYX TIFFs to YXC before model.eval().
    withName: 'CELLPOSE' {
        ext.args = {[
            "--channel_axis -1",
            "--no_npy",
            params.cellpose4_save_flows                 ? "--save_flows"                                                : "",
            params.cellpose4_diameter != null           ? "--diameter ${params.cellpose4_diameter}"                     : "",
            params.cellpose4_custom_model               ? ""                                                            : params.cellpose4_pretrained_model && !(params.cellpose4_pretrained_model.toString().toLowerCase() in ['none', 'null']) ? "--pretrained_model ${params.cellpose4_pretrained_model}" : "",
            params.cellpose4_flow_threshold != null     ? "--flow_threshold ${params.cellpose4_flow_threshold}"         : "",
        ].join(' ').trim()}
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/segmentation/cellpose4/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPCELL_MESMER' {
        ext.args = {[
            "--image-mpp=${params.mesmer_image_mpp}",
            "--compartment=${params.mesmer_compartment}",
            "--nuclear-channel ${params.mesmer_nuclear_channel}",
            params.mesmer_membrane_channel != null      ? "--membrane-channel ${params.mesmer_membrane_channel}"        : "",
        ].join(' ').trim()}
        ext.prefix = { "${meta.id}_mesmer_mask" }
        publishDir = [
            path: { "${params.outdir}/segmentation/mesmer/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RAMI2D_REGISTER' {
        ext.args ={"-mpp-key 3"}
        publishDir = [
            path: { "${params.outdir}/rami2d/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RAMI2D_TRANSFORM' {
        publishDir = [
            path: { "${params.outdir}/rami2d/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STAINWARPY_REGISTER' {
        memory = { 12.GB * task.attempt }
    }


}
