process {

    withName: 'CELLPOSE3' {
        ext.args   = '--channel_axis 0 --diameter 17 --flow_threshold 0.4 --pretrained_model nuclei'
        ext.prefix = { "${meta.id}" }
    }

    withName: 'CELLPOSE' {
        ext.args   = '--no_npy'
        ext.prefix = { "${meta.id}" }
    }

    withName: 'DEEPCELL_MESMER' {
        ext.args   = '--image-mpp=0.65 --compartment=nuclear --nuclear-channel 0'
        ext.prefix = { "${meta.id}_mesmer_mask" }
    }

}
